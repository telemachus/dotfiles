set encoding=utf-8
scriptencoding utf-8

syntax enable
filetype plugin indent on
set backspace=indent,eol,start
set history=500
set scrolloff=0     " No breathing room
set number
set relativenumber
set mouse=          " No mouse capture

" Cursor shape:
"   + steady block in Normal mode
"   + steady block when Vim starts
"   + blinking underline in Insert and Replace modes
"   + reset to blinking underline when Vim exits
let &t_EI = "\<Esc>[2 q"
let &t_SI = "\<Esc>[3 q"
let &t_SR = "\<Esc>[3 q"
if !exists('g:cursor_codes_set')
    let &t_ti ..= "\<Esc>[2 q"
    let &t_te = "\<Esc>[3 q" .. &t_te
    let g:cursor_codes_set = 1
endif

set ruler           " Show the cursor position all the time
set showcmd
set showmode
set ttimeout
set ttimeoutlen=100

if &shell =~# 'fish$'
    set shell=bash
endif

set wrap linebreak breakindent
set showbreak=↪
set list
set listchars=tab:»·,eol:↲,nbsp:␣,trail:•,extends:⟩,precedes:⟨
set autoindent
" t = autowrap text using textwidth
" c = autowrap comments using textwidth
" q = allow formatting of comments with "gq"
" n = recognize numbered lists for formatting purposes
" 1 = do not break line after a one-letter word
set formatoptions=tcqn1
set tabstop=8 softtabstop=0 shiftwidth=8 noexpandtab
set foldmarker={{{,}}}
set foldlevel=0
set foldmethod=marker

set laststatus=2        " Always put a status line in
set showtabline=1       " Show a tabbar only if there are at least two tabs

set ignorecase          " Ignore case in searches
set smartcase           " But care about case if I enter capitals
set gdefault            " Subsitutions are global ('g') by default
set incsearch           " Do incremental searching
set nohlsearch          " Do not hightlight all matches in a search
set conceallevel=0      " Conceal is evil

for s:dir in ['~/.vim_backups', '~/.vim_swap', '~/.vim_undo']
    if !isdirectory(expand(s:dir))
        call mkdir(expand(s:dir), 'p', 0700)
    endif
endfor
unlet s:dir

set backup
set undofile
" A trailing // makes Vim name files by their full path to avoid collisions.
set backupdir=$HOME/.vim_backups//
set directory=$HOME/.vim_swap//
set undodir=$HOME/.vim_undo

if has('syntax') && has('eval')
    packadd! matchit
endif

if executable('rg')
    set grepprg=rg\ --vimgrep\ --smart-case\ --hidden
    set grepformat=%f:%l:%c:%m
endif

" Use bash-style tab completion:
" first tab shows longest common string, and subsequent tabs list all choices
set wildmode=longest,list
set wildignore+=*.o,*.obj,*~
set wildignore+=*DS_Store*
set wildignore+=*.png,*.jpg,*.jpeg,*.gif,*.pdf

set hidden              " No warning, but keep buffers with changes
set title               " Set window title
set shortmess=atIF      " Abbreviate and truncate messages; no intro screen;
                        " don’t display file information on write

set statusline=[%<%.20f][%{&fenc==''?&enc:&fenc}]%y%m%r%h
set statusline+=%=%([Line:\ %l\ Column:\ %c\ %P]%)

set termguicolors
set background=light
set colorcolumn=+1
colorscheme minimum

set printoptions=paper:letter,header:0,syntax:n
set printfont=Consolas

set iskeyword+=-

let g:mapleader=' '
let g:maplocalleader=' '

" Put things here that eventually belong in vim-dotfiles if I keep them.

let g:skip_close_chars = {
        \ '"': v:true,
        \ "'": v:true,
        \ ')': v:true,
        \ '}': v:true,
        \ ']': v:true,
        \ }
inoremap <silent> <expr> <C-CR>
        \ get(g:skip_close_chars, strpart(getline('.'), col('.')-1, 1), v:false)
        \ ? '<C-G>U<Right>'
        \ : '<C-CR>'

" Curly quotes in mail: open at start of line or after whitespace or
" opening punctuation; otherwise close.
function! s:CurlyQuote(left, right) abort
    let l:prev = matchstr(getline('.'), '.\%' .. col('.') .. 'c')
    return l:prev =~# '^[[:space:]([{“‘—/-]\=$' ? a:left : a:right
endfunction

augroup mail_curly_quotes
    autocmd!
    autocmd FileType mail inoremap <buffer> <silent> <expr> " <SID>CurlyQuote('“', '”')
    autocmd FileType mail inoremap <buffer> <silent> <expr> ' <SID>CurlyQuote('‘', '’')
augroup END

" Delete everything below the current line. Mnemonic: t is for trim.
" deletebufline() writes no registers, doesn't move the cursor or view,
" and makes a single undoable change.
function! s:Trim() abort
    if !&modifiable
        echohl ErrorMsg
        echomsg "E21: Cannot make changes, 'modifiable' is off"
        echohl None
        return
    endif

    if line('.') < line('$')
        silent call deletebufline('', line('.') + 1, '$')
    endif
endfunction
nnoremap <silent> <Leader>t <Cmd>call <SID>Trim()<CR>

" Language servers via https://github.com/yegappan/lsp. Keep it quiet: no
" signs, inline highlights, virtual text, autocompletion, snippets, or
" semantic highlighting. Completion is on demand with <C-x><C-o>.
" The plugin loads after vimrc and reads these variables then, so don't call
" LspOptionsSet() or LspAddServer() here.
"
" showSignature (on by default) pops up the signature in Insert mode after
" ( or , and closes it on leaving Insert mode. To turn it off, add
" "showSignature: v:false" below. <Leader>S still works either way.
let g:lsp_options = #{
        \ autoComplete: v:false,
        \ autoHighlightDiags: v:false,
        \ highlightDiagInline: v:false,
        \ semanticHighlight: v:false,
        \ showDiagWithSign: v:false,
        \ showDiagWithVirtualText: v:false,
        \ snippetSupport: v:false,
        \ ignoreMissingServer: v:true,
        \ popupBorder: v:true,
        \ }

let g:lsp_servers = []
if executable('gopls')
    call add(g:lsp_servers, #{
            \ name: 'gopls',
            \ filetype: ['go', 'gomod'],
            \ path: exepath('gopls'),
            \ args: ['serve'],
            \ syncInit: v:true,
            \ workspaceConfig: #{gopls: #{gofumpt: v:true}},
            \ })
endif

" The tagfunc makes <C-]>, g<C-]>, <C-w>], and :tjump use the server, so
" there are no separate go-to-definition mappings.
function! s:LspAttached() abort
    setlocal tagfunc=lsp#lsp#TagFunc
    nnoremap <buffer> <silent> <Leader>R <Cmd>LspRename<CR>
    nnoremap <buffer> <silent> <Leader>T <Cmd>LspGotoTypeDef<CR>
    nnoremap <buffer> <silent> <Leader>S <Cmd>LspShowSignature<CR>
    nnoremap <buffer> <silent> K <Cmd>call <SID>LspHoverOrEnter()<CR>
    nnoremap <buffer> <silent> [d <Cmd>LspDiag prevWrap<CR>
    nnoremap <buffer> <silent> ]d <Cmd>LspDiag nextWrap<CR>
    nnoremap <buffer> <silent> <Leader>d <Cmd>LspDiag current<CR>
    nnoremap <buffer> <silent> <Leader>; <Cmd>call <SID>LspPopupsClose()<CR>
endfunction

" The id of the visible hover popup, or 0 if there isn't one. The plugin
" doesn't expose the id, so recognize the popup by its close callback.
function! s:LspHoverPopup() abort
    for l:id in popup_list()
        if string(get(popup_getoptions(l:id), 'callback', '')) =~# 'HoverPopupClosed'
            return l:id
        endif
    endfor
    return 0
endfunction

" Close the hover and signature popups without moving the cursor. (<Esc>
" also closes the hover.) The plugin keeps the signature popup's id on the
" server as signaturePopup (-1 when there isn't one). Closing it from outside
" is fine: the plugin's close callback resets its signature state.
function! s:LspPopupsClose() abort
    let l:id = s:LspHoverPopup()
    if l:id
        call popup_close(l:id)
    endif
    let l:id = get(lsp#buffer#CurbufGetServer(), 'signaturePopup', -1)
    if l:id > 0
        call popup_close(l:id)
    endif
endfunction

" K shows the hover. With the hover already up, K moves its text into the
" preview window, where you can move around, yank, and search (<C-w>p to go
" back, :pclose to close). The plugin's popup filter does that, but it never
" sees K once mappings are on (see below), so hand it the key.
function! s:LspHoverOrEnter() abort
    let l:id = s:LspHoverPopup()
    if l:id
        call popup_getoptions(l:id).filter(l:id, 'K')
    else
        LspHover
    endif
endfunction

" The plugin opens the hover with mappings off, so <Leader> mappings don't
" work while it's up (<Space> just moves the cursor, which closes it). Turn
" mappings back on. None of the popup's scroll keys are mapped.
function! s:LspHoverAllowMappings() abort
    let l:id = win_getid()
    if l:id == s:LspHoverPopup()
        call popup_setoptions(l:id, #{mapping: v:true})
    endif
endfunction

function! s:LspDetached() abort
    setlocal tagfunc<
    for l:lhs in ['<Leader>R', '<Leader>T', '<Leader>S', 'K', '[d', ']d',
                \ '<Leader>d', '<Leader>;']
        silent! execute 'nunmap <buffer>' l:lhs
    endfor
endfunction

augroup lsp_mappings
    autocmd!
    autocmd User LspAttached call s:LspAttached()
    autocmd User LspDetached call s:LspDetached()
    " No 'showbreak' markers on wrapped lines inside popups. The plugin sets
    " the hover's filetype from inside the popup, so this runs there.
    autocmd FileType * if &buftype ==# 'popup' | setlocal showbreak=NONE | endif
    autocmd FileType lspgfm,text if &buftype ==# 'popup' | call s:LspHoverAllowMappings() | endif
augroup END

" <Leader>; closes the preview window from inside it, as it closes the hover
" popup. This covers the hover's preview split (second K) and :ptag, :pedit,
" and so on.
augroup preview_close
    autocmd!
    " No space before the | after <CR>: it would become part of the mapping.
    autocmd WinEnter * if &previewwindow
                \ | nnoremap <buffer> <silent> <Leader>; <Cmd>pclose<CR>|
                \ endif
augroup END
