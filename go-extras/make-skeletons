#!/usr/bin/env python3

"""Build springerle skeletons for new Go projects from the canonical files.

make-skeletons writes cli.txtar and lib.txtar next to itself. Each one joins
the canonical config files in go-extras (the same files go-drift checks) with
the skeleton-only files in skeleton/common and skeleton/<kind>. Rerun it after
changing any of those files or after a new Go release.

Canonical files are copied literally: any "{{" in them is escaped for Go
templates, and then their @@...@@ placeholders become template fields. Files
under skeleton/ are already springerle templates and are copied as they are,
except that @@NAME@@ in a file path becomes the project name.
"""

import argparse
import re
import sys
from pathlib import Path
from subprocess import run as subprocess_run

CANON_DIR = Path(__file__).resolve().parent
SKELETON_DIR = CANON_DIR / "skeleton"

# Project path -> canonical file name, for each kind of project.
COMMON_FILES = {
    ".golangci.yml": "golangci.yml",
    "revive.toml": "revive.toml",
    "staticcheck.conf": "staticcheck.conf",
    ".github/workflows/go.yml": "go.yml",
    "LICENSE.txt": "LICENSE.txt",
}
KIND_FILES = {
    "cli": COMMON_FILES | {"Makefile": "Makefile.cli", ".gitignore": "gitignore.cli"},
    "lib": COMMON_FILES | {"Makefile": "Makefile.lib"},
}

PREAMBLE = """\
# Generated by make-skeletons from the canonical files in go-extras.
# Do not edit this file; edit those files and rerun make-skeletons.
#
# Usage: springerle -dest ~/go/src/github.com/telemachus {kind}.txtar
# Afterward, run "go mod tidy" in the new project.
name: Project name (lowercase)?
desc: One-line description?
author: Author full name? Peter Aronoff
modPath: Module path (bare while experimental)? {{{{.name}}}}
goVersion: Go version? {go_version}
"""
KIND_PREAMBLES = {
    "cli": """\
funcName: Exported function name? {{xstringstocamelcase .name}}
""",
    "lib": """\
pkg: Package name? {{stringsreplaceall .name "-" ""}}
""",
}


def die(message):
    """Print error message and exit with status 1."""
    print(f"make-skeletons: {message}", file=sys.stderr)
    sys.exit(1)


def go_version(override):
    """Return the current Go release as a (minor, patch) tuple."""
    if override:
        version = override
    else:
        result = subprocess_run(
            ["go", "env", "GOVERSION"], capture_output=True, text=True
        )
        if result.returncode != 0:
            die("cannot run 'go env GOVERSION'")
        version = result.stdout.strip().removeprefix("go")

    match = re.fullmatch(r"1\.(\d+)\.(\d+)", version)
    if not match:
        die(f"cannot parse Go version {version!r}")

    return int(match[1]), int(match[2])


def expected_go(kind, minor, patch):
    """Return the go directive and CI matrix for the kind."""
    if kind == "cli":
        return f"1.{minor}.{patch}", f"'1.{minor}.x'"

    return f"1.{minor - 1}.0", f"'1.{minor - 1}.x', '1.{minor}.x'"


def canonical_template(text, go_matrix):
    """Turn a canonical file into a springerle template."""
    text = text.replace("{{", '{{"{{"}}')
    text = text.replace("@@NAME@@", "{{.name}}")
    text = text.replace("@@GO_MATRIX@@", go_matrix)
    text = text.replace("@@YEAR@@", '{{timenow.Format "2006"}}')
    text = text.replace("@@AUTHOR@@", "{{.author}}")
    if "@@" in text:
        die(f"unknown placeholder in {text[text.index('@@'):][:30]!r}")

    return text


def skeleton_files(kind):
    """Yield (project path, text) for the skeleton-only files of the kind."""
    for subdir in ("common", kind):
        root = SKELETON_DIR / subdir
        for path in sorted(p for p in root.rglob("*") if p.is_file()):
            rel_path = path.relative_to(root).as_posix()
            yield rel_path.replace("@@NAME@@", "{{.name}}"), path.read_text()


def build(kind, minor, patch):
    """Return the txtar text for the kind."""
    go_directive, go_matrix = expected_go(kind, minor, patch)
    files = []
    for rel_path, canon_name in KIND_FILES[kind].items():
        text = (CANON_DIR / canon_name).read_text()
        files.append((rel_path, canonical_template(text, go_matrix)))
    files.extend(skeleton_files(kind))

    parts = [
        PREAMBLE.format(kind=kind, go_version=go_directive),
        KIND_PREAMBLES[kind],
    ]
    for rel_path, text in sorted(files):
        if not text.endswith("\n"):
            text += "\n"
        parts.append(f"-- {{{{.name}}}}/{rel_path} --\n{text}")

    return "".join(parts)


def main():
    parser = argparse.ArgumentParser(
        description="Build cli.txtar and lib.txtar from the canonical files.",
    )
    parser.add_argument(
        "-g",
        "--go",
        metavar="VERSION",
        help="current Go release, e.g. 1.27.2 (default: go env GOVERSION)",
    )
    parser.add_argument(
        "-o",
        "--out",
        type=Path,
        default=CANON_DIR,
        help=f"directory for the txtar files (default: {CANON_DIR})",
    )
    args = parser.parse_args()

    minor, patch = go_version(args.go)
    for kind in KIND_FILES:
        out = args.out / f"{kind}.txtar"
        out.write_text(build(kind, minor, patch))
        print(f"wrote {out}")


if __name__ == "__main__":
    main()
