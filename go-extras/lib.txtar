# Generated by make-skeletons from the canonical files in go-extras.
# Do not edit this file; edit those files and rerun make-skeletons.
#
# Usage: springerle -dest ~/go/src/github.com/telemachus lib.txtar
# Afterward, run "go mod tidy" in the new project.
name: Project name (lowercase)?
desc: One-line description?
author: Author full name? Peter Aronoff
modPath: Module path (bare while experimental)? {{.name}}
goVersion: Go version? 1.26.0
pkg: Package name? {{stringsreplaceall .name "-" ""}}
-- {{.name}}/.github/workflows/go.yml --
name: {{.name}}
on:
  push:
    branches:
      - '**'
  pull_request:
    branches:
      - '**'

jobs:
  test:
    runs-on: ${{"{{"}} matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os:
          - ubuntu-latest
          - macos-latest
          - windows-latest
        go: ['1.26.x', '1.27.x']
    name: {{.name}} test (using go ${{"{{"}} matrix.go }} on ${{"{{"}} matrix.os }})
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-go@v7
        with:
          go-version: ${{"{{"}} matrix.go }}
          check-latest: true
      - run: make testr
-- {{.name}}/.golangci.yml --
version: "2"
linters:
  default: none
  enable:
    - asciicheck
    - bidichk
    - copyloopvar
    - cyclop
    - depguard
    - dogsled
    - dupl
    - errcheck
    - errchkjson
    - errname
    - errorlint
    - exhaustive
    - exptostd
    - funcorder
    - funlen
    - gocheckcompilerdirectives
    - goconst
    - gocritic
    - godoclint
    - godot
    - govet
    - iface
    - importas
    - inamedparam
    - ineffassign
    - interfacebloat
    - intrange
    - ireturn
    - maintidx
    - makezero
    - mirror
    - misspell
    - modernize
    - nakedret
    - nestif
    - nilerr
    - nlreturn
    - nolintlint
    - nonamedreturns
    - paralleltest
    - perfsprint
    - prealloc
    - predeclared
    - reassign
    - recvcheck
    - thelper
    - tparallel
    - unconvert
    - unparam
    - unused
    - usestdlibvars
    - usetesting
    - varnamelen
    - wastedassign
    - whitespace
    - wrapcheck
  exclusions:
    rules:
      - path: _test\.go
        linters:
          - dupl
          - funlen
          - goconst
          - wrapcheck
  settings:
    copyloopvar:
      check-alias: true
    cyclop:
      max-complexity: 10
      package-average: 0
    depguard:
      rules:
        main:
          files:
            - $all
          deny:
            - pkg: reflect
              desc: avoid reflect
            - pkg: math/rand
              desc: use crypto/rand
            - pkg: math/rand/v2
              desc: use crypto/rand
    errcheck:
      check-type-assertions: true
      check-blank: true
      exclude-functions:
        - errors.AsType
        - fmt.Print
        - fmt.Printf
        - fmt.Println
        - fmt.Fprint
        - fmt.Fprintf
        - fmt.Fprintln
        - strings.Builder.WriteString
        - strings.Builder.WriteRune
    exhaustive:
      default-signifies-exhaustive: true
    goconst:
      min-len: 2
      min-occurrences: 3
    gocritic:
      disabled-checks:
        - hugeParam
        - unnamedResult
      enabled-tags:
        - diagnostic
        - experimental
        - opinionated
        - performance
        - style
    govet:
      enable-all: true
    nlreturn:
      block-size: 2
    nolintlint:
      require-explanation: true
      require-specific: true
    varnamelen:
      max-distance: 10
      min-name-length: 2
      ignore-decls:
        - i int
formatters:
  exclusions:
    generated: lax
    paths:
      - third_party$
      - builtin$
      - examples$
issues:
  max-issues-per-linter: 0
  max-same-issues: 0
  uniq-by-line: false
  fix: false
run:
  timeout: 2m
  concurrency: 0
  issues-exit-code: 1
  tests: true
  allow-parallel-runners: false
