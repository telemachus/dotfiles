# info: print a formatted message to stdout
#
# Args: format [args...]
#   format and args are passed to printf (write a literal % as %%)
# Exit code: whatever printf returns as $?
#
# Examples:
#   info 'wonderful news'
#   mkdir -p -- "$P" && info '`mkdir -p -- %s` succeeded' "$P"
#
printf "%s: ${1:-empty message}\n" "${funcstack[2]:-unknown caller}" "${@:2}"

