# toss: move one or more items into a directory, creating it as needed
#
# Args: $1..$#-1 = sources to move; last arg = target directory
# Exit code: 1 if there are fewer than two args,
#   otherwise result of mkdir -p or mv if they fail, or 0
#
# Examples:
#   toss report.txt archive/2026
#   toss *.log old-logs/rotated/september
#
(( $# < 2 )) && {
    warn 'toss requires at least one source and a target directory'
    return
}

mkdir -p -- "${@[-1]}" || {
    warn "$(printf '`mkdir -p -- %s` failed' "${@[-1]}")" $?
    return
}

mv -v -- "$@" || warn "$(printf '`mv -v -- %s` failed' "$*")"

