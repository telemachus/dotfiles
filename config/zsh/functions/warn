# warn: print a formatted message to stderr
#
# Args: [-s status] format [args...]
#   -s status = return value (default: 1)
#   format and args are passed to printf (write a literal % as %%)
# Return value: status (or 1 if -s is not given)
#
# Examples:
#   warn 'something broke'
#   mkdir -p -- "$P" || warn -s $? '`mkdir -p -- %s` failed' "$P"
#
local st=1
if [[ $1 == -s ]]; then
    st=$2
    shift 2
fi

printf >&2 "%s: ${1:-empty message}\n" "${funcstack[2]:-unknown caller}" "${@:2}"
return $st

