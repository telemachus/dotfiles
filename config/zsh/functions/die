# die: print a formatted message to stderr and exit current shell session
#
# Args: [-s status] format [args...]
#   -s status = exit code (default: 1)
#   format and args are passed to printf (write a literal % as %%)
# Exit code: status (or 1 if -s is not given)
#
# Examples:
#   die -s 3 'something broke'
#   mkdir -p -- "$P" || die -s $? '`mkdir -p -- %s` failed' "$P"
#
local st=1
if [[ $1 == -s ]]; then
    st=$2
    shift 2
fi
local fmt=${1:-empty message}

if [[ -o interactive ]]; then
    printf >&2 'This will exit your shell. Continue? (y/N) '
    read -q || {
        # Turn die into warn if the user says no.
        printf >&2 "\n%s: $fmt\n" "${funcstack[2]:-unknown caller}" "${@:2}"
        return $st
    }
    # If the user says yes, clean up the prompt line.
    printf >&2 '\n'
fi

printf >&2 "%s: $fmt\n" "${funcstack[2]:-unknown caller}" "${@:2}"
exit $st

