#!/usr/bin/env dash
#
# backpack: back up documents, pictures, mail, and music to olympus.

set -u

die() {
    fmt=$1
    shift
    printf >&2 "%s: $fmt\n" "${0##*/}" "$@"
    exit 1
}

DEST='/Volumes/olympus/cito'

[ -d "$DEST" ] || die '%s not found; is olympus mounted?' "$DEST"

# backup [rsync options...] SRC DEST
backup() {
    rsync -rvz --ignore-existing --exclude '.DS_Store' --exclude '.localized' "$@"
}

backup --exclude 'cltk_data' --exclude 'Zoom' \
    "${HOME}/Documents/" "${DEST}/documents" || die 'backup of Documents failed'
backup "${HOME}/Pictures/videnda/" "${DEST}/videnda" || die 'backup of videnda failed'
backup "${HOME}/.maildir/" "${DEST}/maildir" || die 'backup of maildir failed'
backup "${HOME}/.musica/" "${DEST}/musica" || die 'backup of musica failed'
